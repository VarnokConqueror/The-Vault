APP_BUNDLE_IDENTIFIER = com.yourteam.thevault.dev
APP_TESTS_BUNDLE_IDENTIFIER = $(APP_BUNDLE_IDENTIFIER).RunnerTests
APPLE_DEVELOPMENT_TEAM = ABCDE12345
