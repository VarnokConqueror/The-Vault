require "base64"

default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight beta"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: Base64.decode64(ENV.fetch("APP_STORE_CONNECT_API_KEY_B64")),
      duration: 1200,
      in_house: false
    )

    output_name = ENV.fetch("IOS_IPA_NAME", "TheVault")
    external_groups = ENV.fetch("TESTFLIGHT_EXTERNAL_GROUPS", "")
      .split(",")
      .map(&:strip)
      .reject(&:empty?)

    build_ios_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      output_name: "#{output_name}.ipa"
    )

    upload_options = {
      api_key: api_key,
      ipa: File.join("build", "ios", "ipa", "#{output_name}.ipa"),
      skip_waiting_for_build_processing: true
    }

    unless external_groups.empty?
      upload_options[:distribute_external] = true
      upload_options[:groups] = external_groups
    end

    changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").strip
    upload_options[:changelog] = changelog unless changelog.empty?

    upload_to_testflight(**upload_options)
  end
end
